rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function connectionId(uidA, uidB) {
      return uidA < uidB
        ? uidA + "_" + uidB
        : uidB + "_" + uidA;
    }

    function isBlocked(uidA, uidB) {
      return exists(
          /databases/$(database)/documents/blocks/$(uidA + "_" + uidB)
        )
        || exists(
          /databases/$(database)/documents/blocks/$(uidB + "_" + uidA)
        );
    }

    function connected(uidA, uidB) {
      return exists(
        /databases/$(database)/documents/connections/$(connectionId(uidA, uidB))
      );
    }

    function profileExists(uid) {
      return exists(
        /databases/$(database)/documents/profiles/$(uid)
      );
    }

    function canReadProfile(uid) {
      return signedIn()
        && profileExists(uid)
        && !isBlocked(request.auth.uid, uid)
        && (
          request.auth.uid == uid
          || (
            get(/databases/$(database)/documents/profiles/$(uid))
              .data.isPrivate != true
            && get(/databases/$(database)/documents/profiles/$(uid))
              .data.allowDiscovery == true
          )
          || connected(request.auth.uid, uid)
        );
    }

    function canReadPost() {
      return signedIn()
        && !isBlocked(request.auth.uid, resource.data.uid)
        && (
          request.auth.uid == resource.data.uid
          || (
            resource.data.visibility == "public"
            && canReadProfile(resource.data.uid)
          )
          || (
            resource.data.visibility == "connections"
            && connected(request.auth.uid, resource.data.uid)
          )
        );
    }

    match /profiles/{uid} {
      allow get: if canReadProfile(uid);
      allow list: if signedIn()
        && resource.data.allowDiscovery == true
        && resource.data.isPrivate != true
        && !isBlocked(request.auth.uid, uid);

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasAll([
          "uid", "displayName", "email", "bio",
          "isPrivate", "allowDiscovery", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid", "displayName", "email", "bio", "photoURL",
          "isPrivate", "allowDiscovery", "createdAt", "updatedAt"
        ])
        && validString(request.resource.data.displayName, 80)
        && validString(request.resource.data.email, 254)
        && validString(request.resource.data.bio, 500)
        && request.resource.data.isPrivate is bool
        && request.resource.data.allowDiscovery is bool
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "displayName", "bio", "photoURL",
            "isPrivate", "allowDiscovery", "updatedAt"
          ])
        && validString(request.resource.data.displayName, 80)
        && validString(request.resource.data.bio, 500)
        && request.resource.data.isPrivate is bool
        && request.resource.data.allowDiscovery is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /posts/{postId} {
      allow get, list: if canReadPost();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          "uid", "text", "mood", "visibility",
          "likeCount", "commentCount", "createdAt", "updatedAt"
        ])
        && request.resource.data.uid is string
        && validString(request.resource.data.text, 5000)
        && validString(request.resource.data.mood, 40)
        && request.resource.data.visibility in [
          "public", "connections", "private"
        ]
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !isBlocked(request.auth.uid, request.auth.uid);

      allow update: if isSelf(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["text", "mood", "visibility", "updatedAt"])
        && validString(request.resource.data.text, 5000)
        && validString(request.resource.data.mood, 40)
        && request.resource.data.visibility in [
          "public", "connections", "private"
        ]
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /likes/{likeUid} {
        allow get, list: if signedIn()
          && canReadPost();

        allow create, update, delete: if false;
      }

      match /comments/{commentId} {
        allow get, list: if canReadPost();

        allow create, update, delete: if false;
      }
    }

    match /stories/{storyId} {
      allow get, list: if signedIn()
        && resource.data.expiresAt > request.time
        && !isBlocked(request.auth.uid, resource.data.uid)
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.visibility == "public"
            && canReadProfile(resource.data.uid)
          )
          || (
            resource.data.visibility == "connections"
            && connected(request.auth.uid, resource.data.uid)
          )
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(24, "h");

      allow update, delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow read, write: if false;
    }

    match /connections/{connectionId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    match /blocks/{blockId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    match /locations/{uid} {
      allow read, write: if false;
    }

    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
