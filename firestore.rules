rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function connectionId(uidA, uidB) {
      return uidA < uidB
        ? uidA + "_" + uidB
        : uidB + "_" + uidA;
    }

    function isBlocked(uidA, uidB) {
      return exists(
        /databases/$(database)/documents/blocks/$(uidA + "_" + uidB)
      ) || exists(
        /databases/$(database)/documents/blocks/$(uidB + "_" + uidA)
      );
    }

    function connected(uidA, uidB) {
      return exists(
        /databases/$(database)/documents/connections/$(connectionId(uidA, uidB))
      );
    }

    function profileExists(uid) {
      return exists(
        /databases/$(database)/documents/profiles/$(uid)
      );
    }

    function canReadProfile(uid) {
      return signedIn()
        && profileExists(uid)
        && !isBlocked(request.auth.uid, uid)
        && (
          request.auth.uid == uid
          || connected(request.auth.uid, uid)
          || (
            get(/databases/$(database)/documents/profiles/$(uid))
              .data.isPrivate == false
            && get(/databases/$(database)/documents/profiles/$(uid))
              .data.allowDiscovery == true
          )
        );
    }

    function canReadPostDocument(postId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/posts/$(postId)
        )
        && canReadPostData(
          get(/databases/$(database)/documents/posts/$(postId)).data
        );
    }

    function canReadPostData(postData) {
      return signedIn()
        && !isBlocked(request.auth.uid, postData.uid)
        && (
          request.auth.uid == postData.uid
          || (
            postData.visibility == "public"
            && canReadProfile(postData.uid)
          )
          || (
            postData.visibility == "connections"
            && connected(request.auth.uid, postData.uid)
          )
        );
    }

    function validProfile(data, uid) {
      return data.uid == uid
        && data.keys().hasAll([
          "uid",
          "displayName",
          "handle",
          "email",
          "photoURL",
          "bio",
          "isPrivate",
          "allowDiscovery",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "uid",
          "displayName",
          "handle",
          "email",
          "photoURL",
          "bio",
          "isPrivate",
          "allowDiscovery",
          "createdAt",
          "updatedAt"
        ])
        && validString(data.displayName, 80)
        && validString(data.handle, 40)
        && validString(data.email, 254)
        && validString(data.photoURL, 2048)
        && validString(data.bio, 500)
        && data.isPrivate is bool
        && data.allowDiscovery is bool;
    }

    function validPost(data) {
      return data.uid == request.auth.uid
        && validString(data.text, 5000)
        && validString(data.mood, 40)
        && data.visibility in ["public", "connections", "private"]
        && data.likeCount == 0
        && data.commentCount == 0
        && (data.media == null || data.media is map)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // PROFILES
    match /profiles/{uid} {
      allow get: if isSelf(uid) || canReadProfile(uid);

      allow list: if signedIn()
        && resource.data.allowDiscovery == true
        && resource.data.isPrivate == false
        && !isBlocked(request.auth.uid, resource.data.uid);

      allow create: if isSelf(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSelf(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Deletion is performed by a trusted backend.
      allow delete: if false;
    }

    // POSTS
    match /posts/{postId} {
      allow get, list: if canReadPostData(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          "uid",
          "displayName",
          "handle",
          "photoURL",
          "text",
          "mood",
          "media",
          "visibility",
          "isStory",
          "likeCount",
          "commentCount",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasOnly([
          "uid",
          "displayName",
          "handle",
          "photoURL",
          "text",
          "mood",
          "media",
          "visibility",
          "isStory",
          "likeCount",
          "commentCount",
          "createdAt",
          "updatedAt"
        ])
        && validPost(request.resource.data)
        && request.resource.data.isStory == false
        && !isBlocked(request.auth.uid, request.auth.uid);

      // Counters and post deletion must use trusted backend functions.
      allow update, delete: if false;

      match /likes/{likeUid} {
        allow get, list: if canReadPostDocument(postId);
        allow create, update, delete: if false;
      }

      match /comments/{commentId} {
        allow get, list: if canReadPostDocument(postId);
        allow create, update, delete: if false;
      }
    }

    // STORIES
    match /stories/{storyId} {
      allow get, list: if signedIn()
        && resource.data.expiresAt > request.time
        && !isBlocked(request.auth.uid, resource.data.uid)
        && (
          request.auth.uid == resource.data.uid
          || (
            resource.data.visibility == "public"
            && canReadProfile(resource.data.uid)
          )
          || (
            resource.data.visibility == "connections"
            && connected(request.auth.uid, resource.data.uid)
          )
        );

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
          "uid",
          "text",
          "visibility",
          "expiresAt",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
          <= request.time + duration.value(24, "h");

      allow update, delete: if false;
    }

    // CONNECTIONS: backend only
    match /connectionRequests/{requestId} {
      allow read, write: if false;
    }

    match /connections/{connectionDocId} {
      allow read, write: if false;
    }

    // NOTIFICATIONS: backend only
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // BLOCKS: backend only
    match /blocks/{blockId} {
      allow read, write: if false;
    }

    // REPORTS: backend only
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // PRIVATE LOCATION DATA: backend only
    match /locations/{uid} {
      allow read, write: if false;
    }

    // RATE LIMIT RECORDS: backend only
    match /rateLimits/{rateLimitId} {
      allow read, write: if false;
    }

    // Default deny for every unspecified collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
